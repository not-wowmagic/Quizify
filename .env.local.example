# Copy this file to .env.local and fill in your actual API key
# Gemini API Key (get it from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Fallback Gemini API Key (used when the primary key is rate-limited)
GEMINI_API_KEY_FALLBACK=your_fallback_gemini_api_key_here

# Default model (gemini-3.1-flash-lite is fast, low latency, and supports JSON output mode)
GEMINI_MODEL=gemini-3.1-flash-lite
