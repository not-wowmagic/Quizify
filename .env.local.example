# Copy this file to .env.local and fill in your actual API key
# .env.local is gitignored, so your keys never reach GitHub.
# IMPORTANT: never put real keys in this file, because it IS committed to the repo.

# ── AI provider ─────────────────────────────────────────────────────────────
# Which backend to use for quiz generation:
#   "opencode" (default), the opencode AI gateway (subscription or Zen credits)
#   "gemini", the direct Google Generative Language API (optional fallback)
AI_PROVIDER=opencode

# ── opencode (default provider) ─────────────────────────────────────────────
# Get your API key at https://opencode.ai/auth
# Works with the opencode subscription or opencode Zen (pay-as-you-go).
OPENCODE_API_KEY=your_opencode_api_key_here

# Model served through opencode (see https://opencode.ai/docs/go and /docs/zen)
OPENCODE_MODEL=muse-spark-1.2-contributor

# Optional override. Defaults to the opencode chat/completions endpoint:
#   opencode (subscription): https://opencode.ai/zen/go/v1/chat/completions
#   opencode Zen (pay-as-you-go): https://opencode.ai/zen/v1/chat/completions
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions

# Vision model used for photo OCR (camera/scan ingestion). Served through the
# same opencode endpoint + API key. MiMo-V2.5 is vision-capable and included
# in the opencode subscription (zero-retention per opencode's privacy policy).
OPENCODE_VISION_MODEL=mimo-v2.5

# ── Gemini (optional fallback provider, used when AI_PROVIDER=gemini) ───────
# Gemini API Key (get it from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Optional: Cloudflare Turnstile bot protection ───────────────────────────
# Leave unset to skip the widget and server-side verification entirely.
# Get keys at https://dash.cloudflare.com/sign-up?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional: production origin (used for sitemap, robots, canonical, og:image)
# Must be a public URL; this value is NOT secret.
NEXT_PUBLIC_SITE_URL=https://quizify.netlify.app

# ── Optional: Supabase (quiz history + shareable links) ─────────────────────
# Leave unset to run without history/sharing; the app degrades gracefully.
# Get these from your Supabase project dashboard: Settings → API.
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY is server-only; never prefix it with
# NEXT_PUBLIC_ or it will be exposed to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Optional: Upstash Redis (global rate limiting) ─────────────────────────
# Leave unset to use the built-in in-memory rate limiter (per serverless
# instance). Get credentials at https://console.upstash.com → create database.
# Both must be set to enable the global sliding-window limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional: Umami analytics (privacy-first, cookie-free) ─────────────────
# Leave unset to skip the tracking script entirely.
# IMPORTANT: this file is committed, so put your real website id in .env.local.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: self-hosted Umami script URL (defaults to Umami Cloud).
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
